<Application x:Class="WooCommerceProductManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:WooCommerceProductManager.Helpers">
    <Application.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="VisibleWhenTrueConverter" />
        <helpers:BooleanToVisibilityConverter x:Key="VisibleWhenFalseConverter" Invert="True" />
        <helpers:NullOrEmptyToVisibilityConverter x:Key="VisibleWhenHasTextConverter" />
        <helpers:UrlToImageSourceConverter x:Key="UrlToImageSourceConverter" />

        <SolidColorBrush x:Key="HeaderBrush" Color="#1F4E79" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2E75B6" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F6F8" />
        <SolidColorBrush x:Key="BorderBrushColor" Color="#D0D7DE" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#5B6570" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#1B7F3A" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2328" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderBrush" Value="#D0D7DE" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="88" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2E75B6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="UnsyncedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B45309" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Application.Resources>
</Application>
