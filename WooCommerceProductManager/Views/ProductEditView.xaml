<UserControl x:Class="WooCommerceProductManager.Views.ProductEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:WooCommerceProductManager.Helpers"
             xmlns:vm="clr-namespace:WooCommerceProductManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductEditViewModel}"
             d:DesignHeight="640"
             d:DesignWidth="360">
    <Border Background="White" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Product" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                <Grid Width="160" Height="160" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <Border Background="#EEF2F6" CornerRadius="6">
                        <TextBlock Text="{Binding PlaceholderText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="8" />
                    </Border>
                    <Image Stretch="UniformToFill"
                           helpers:ImageLoadBehavior.HideOnFailure="True"
                           Visibility="{Binding ImageUrl, Converter={StaticResource VisibleWhenHasTextConverter}}"
                           Source="{Binding ImageUrl, Converter={StaticResource UrlToImageSourceConverter}}" />
                </Grid>

                <TextBlock Text="Title" Margin="0,0,0,4" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         IsEnabled="{Binding CanEdit}" />

                <TextBlock Text="SKU" Margin="0,0,0,4" />
                <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         IsEnabled="{Binding CanEdit}" />

                <TextBlock Text="Regular Price" Margin="0,0,0,4" />
                <TextBox Text="{Binding RegularPrice, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         IsEnabled="{Binding CanEdit}" />

                <TextBlock Text="Sale Price" Margin="0,0,0,4" />
                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         IsEnabled="{Binding CanEdit}" />

                <TextBlock Text="Stock Quantity" Margin="0,0,0,4" />
                <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10"
                         IsEnabled="{Binding IsStockQuantityEnabled}" />

                <TextBlock Text="Stock Status" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding StockStatusChoices}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding StockStatus}"
                          Margin="0,0,0,16"
                          IsEnabled="{Binding CanEdit}" />

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding ValidationMessage, Converter={StaticResource VisibleWhenHasTextConverter}}" />

                <TextBlock Text="{Binding SaveMessage}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding SaveMessage, Converter={StaticResource VisibleWhenHasTextConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaveSuccessful}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Content="Save"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
